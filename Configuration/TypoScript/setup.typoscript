page.includeCSS.bistumsligaFrontendCss = {$plugin.tx_bistumsliga.settings.FrontendCss}

lib.t3sports.match.date.H0000.strftime = %d.%m.%y

plugin.tx_powermail.settings.misc.htmlForHtmlFields = 1

#plugin.tx_powermail.settings.setup.dataProcessors {
#  30 {
#    class = Bistumsliga\Bistumsliga\DataProcessor\MatchReportDataProcessor
#  }
#}

lib.competitionOptions = CONTENT
lib.competitionOptions {
  table = tx_cfcleague_competition
  select.pidInList = 94
  select.selectFields = name
  select.orderBy = name
  renderObj = COA
  renderObj {
    10 = TEXT
    10.field = name

    20 = TEXT
    20.value = |

    30 = TEXT
    30.field = name

      stdWrap.wrap = |[\n]
  }
}

lib.teamOptions = CONTENT
lib.teamOptions {
  table = tx_cfcleague_teams
  select.pidInList = 93
  select.orderBy = name
  renderObj =< lib.competitionOptions.renderObj
}

lib.roundOptions = CONTENT
lib.roundOptions {
  table = tx_cfcleague_games
  select.selectFields = round_name
  select.groupBy = round_name
  select.orderBy = round_name
  select.pidInList = 94
  renderObj = COA
    renderObj {
      10 = TEXT
      10.field = round_name

      20 = TEXT
      20.value = |

      30 = TEXT
      30.field = round_name

        stdWrap.wrap = |[\n]
    }
}
